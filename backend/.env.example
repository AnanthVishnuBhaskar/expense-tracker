# Copy to .env and fill in.
ANTHROPIC_API_KEY=
DATABASE_URL=postgresql+psycopg://expense:expense@localhost:5432/expense
# Optional overrides
# FAST_MODEL=claude-haiku-5-5
# EXTRACTION_MODEL=claude-opus-5-5
# EXTRACTION_EFFORT=low
# How many receipts are read at the same time
# READER_WORKERS=4

# Security
# People create their own accounts on the sign-up page. Set to false to stop new sign-ups.
# ALLOW_SIGNUP=true
# Signs session cookies. Leave empty to use a random one kept in data/session_secret.
SESSION_SECRET=
# SESSION_TTL_HOURS=336
# Turn both on when serving over HTTPS
# COOKIE_SECURE=true
# HSTS=true
# UPLOADS_PER_HOUR=60
# MAX_FILES_PER_UPLOAD=20
# LOGIN_ATTEMPTS_PER_15_MIN=10
